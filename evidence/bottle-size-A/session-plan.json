  "stages": [
    {
      "id": "readiness",
      "minutes": 30,
      "work": "Freeze input/source/checkpoint hashes; verify idle owned container, GPU guard, disk budget, closed recordings and all current level/tracker gates."
    },
    {
      "id": "dry_geometry",
      "minutes": 45,
      "max_episodes": 45,
      "work": "Native derived collision/mass/inertia inspection, IK clearance, then up to three grasp/lift/tilt/side-return/release trials per 15 development shapes; zero liquid."
    },
    {
      "id": "calibration",
      "minutes": 150,
      "max_episodes": 120,
      "work": "Up to 90 training and 30 development-validation episodes, split by complete episode before capture. Six train/two validation per shape. Balance low/intermediate/high cup fills and static/moving source views; vary table layout. Native integrity and actual camera review required."
    },
    {
      "id": "supervised_fit",
      "minutes": 75,
      "max_candidates": 3,
      "work": "Independent RGB/color and bottle localization/source-presence fits, plus contextual BC only from verified motion demonstrations if collected. Checkpoint every ten epochs; unchanged accuracy gates; no heldout fitting."
    },
    {
      "id": "development",
      "minutes": 60,
      "max_episodes": 12,
      "work": "Only after all perception/geometry checks pass: six full-stop and six empty-stop development pours covering height/width extremes, simultaneous upright-and-side-return. Preserve all failures; repair only within stage budget."
    },
    {
      "id": "reserved",
      "minutes": 90,
      "max_episodes": 30,
      "work": "Only after development passes, freeze everything; 30 once-only autonomous tests, 15 full/15 empty, including the four withheld intermediate shapes and new layout/fill combinations. No tuning, retries or online updates."
    },
    {
      "id": "archive",
      "minutes": 30,
      "work": "Close HDF5, hash reports/models/sources, audit all outcomes, produce labeled all-attempt video and commit/push small evidence. Preserve failed or interrupted attempts as failures/incomplete, never silently retry."
    }
  ],
