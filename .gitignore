*.tar
*.gz
*.whl
*.so
*.dylib
*.dll
*.log
*.mp4
*.mov
*.webm
*.png
*.jpg
*.jpeg
*.gif

# Recovered private history, vendor checkouts and historical local snapshots
/recovered/
/runtime/assets/
/runtime/robotis_lab/
/runtime/diagnostics/
/runtime/rollback/
/runtime/encoder/*.reference.*

# Keep only small study reports/provenance, not raw evidence or camera frames
