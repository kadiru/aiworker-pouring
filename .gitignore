# Local environments, generated builds and caches
.DS_Store
._*
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Credentials and machine-local connection settings
.env
.env.*
!.env.example
.npmrc
.ssh/
*.key
*.pem
*.p12
*.pfx
*known-hosts*
*known_hosts*

# Training data, model weights and large simulation artifacts stay external
/data/
/media/
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.npy
*.npz
*.usd
